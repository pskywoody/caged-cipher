      "groups": {
        "威压深远": {
          "pitch": "-5Hz",
          "lines": [
            { "id": "VO_SS_01", "text": "尘埃落定之时，星辰梭的光芒将再次显现。", "emotion": "威压·深远" },
            { "id": "VO_SS_02", "text": "当年我布下这道题，就是想问守笼人一个问题——如果一道题有两个正确答案，你选哪一个？", "emotion": "威压·深远" },
            { "id": "VO_SS_03", "text": "这不是教学卷。这是我三十年前为自己设下的终极考验——一道需要同时运用并蒂锁、三子法、二连纵横阵和三才游鱼阵才能解开的笼局。", "emotion": "威压·深远" },
            { "id": "VO_SS_04", "text": "我花了三天三夜才解开它。如果你能独立完成——你就不再是我的学生，而是与我并列的设局者。", "emotion": "威压·深远" },
            { "id": "VO_SS_05", "text": "……不是我写的。是另一个人。但那封信，是我让她写的。", "emotion": "威压·深远" }
          ]
        },
        "释然消散": {
          "pitch": "-3Hz",
          "lines": [
            { "id": "VO_SS_06", "text": "……你做到了。", "emotion": "释然·消散" },
            { "id": "VO_SS_07", "text": "星辰梭的奥义，从来不是某一种构型、某一条规则。它是一种信念——在混沌的数字迷雾中，永远存在着秩序，等待被发现。", "emotion": "威压·深远" },
            { "id": "VO_SS_08", "text": "从今以后，你就是新的设局人。档案馆、星辰梭、还有这六卷秘术——都交给你了。", "emotion": "释然·消散" },
            { "id": "VO_SS_09", "text": "……等你问这个问题，等了很久。", "emotion": "释然·消散" },
            { "id": "VO_SS_10", "text": "……你终于看到这里了。", "emotion": "释然·消散" },
            { "id": "VO_SS_11", "text": "不必叫我老师。当你能看懂三才游鱼阵的那一刻，你已经超越了我当年的水平。", "emotion": "释然·消散" },
            { "id": "VO_SS_12", "text": "但记住——技巧是死的，洞察是活的。星辰梭的真正奥义，从来不是某一种固定的构型，而是在混沌中看见秩序的眼睛。", "emotion": "释然·消散" },
            { "id": "VO_SS_13", "text": "……你来了。就够了。", "emotion": "释然·消散" }
          ]
        }
      }
    },
    "shenmo": {
      "name": "沈墨",
      "voiceId": "zh-CN-YunxiNeural",
      "voiceStyle": "calm",
      "rate": "-5%",
      "volume": "-10%",
      "filePrefix": "VO_SM_",
