      ],
      "lines": [
        { "id": "VO_SM_01", "text": "……好。", "emotion": "平静·应答", "type": "short" },
        { "id": "VO_SM_02", "text": "……这样快一些。", "emotion": "平静·赞同", "type": "short" },
        { "id": "VO_SM_03", "text": "……你刚才说\"我爸留下的图\"。你父亲是这里的档案员？", "emotion": "温和·询问", "type": "normal" },
        { "id": "VO_SM_04", "text": "……不认识。但我收到过一封信。署名是\"一个被困在数字里的人\"。", "emotion": "回忆·叙述", "type": "normal" },
        { "id": "VO_SM_06", "text": "……也许。但如果通关了，我就得走了。", "emotion": "低沉·犹豫", "type": "normal" },
        { "id": "VO_SM_07", "text": "……2。她是对的。", "emotion": "确认·领悟", "type": "short" },
        { "id": "VO_SM_09", "text": "……嗯。", "emotion": "确认·共鸣", "type": "short" },
        { "id": "VO_SM_10", "text": "……他一直在等我们找到这里。", "emotion": "低沉·确认", "type": "normal" },
        { "id": "VO_SM_11", "text": "……我不是来解开这一局的。我是来找到你的。", "emotion": "低沉·确认", "type": "core" },
        { "id": "VO_SM_12", "text": "……第二行第四列。5。", "emotion": "专注·计算", "type": "short" },
        { "id": "VO_SM_14", "text": "……是等一个人，还是等一种人？", "emotion": "低沉·询问", "type": "normal" },
        { "id": "VO_SM_15", "text": "……藏的不是答案。藏的是——指向答案的路。", "emotion": "低沉·领悟", "type": "normal" },
        { "id": "VO_SM_16", "text": "……你看这样是不是清楚一点。", "emotion": "温和·陪伴", "type": "normal" },
        { "id": "VO_SM_18", "text": "……他丢下的每一片，都困了人很久。", "emotion": "低沉·确认", "type": "normal" },
        { "id": "VO_SM_19", "text": "……他布的局，不是让人看不见答案。是让人看不见自己走过了几条线。", "emotion": "低沉·领悟", "type": "normal" },
        { "id": "VO_SM_20", "text": "……就像人一样。", "emotion": "低沉·感慨", "type": "short" },
        { "id": "VO_SM_22", "text": "……最后一局。不是她的。是他的。", "emotion": "低沉·预感", "type": "whisper", "volumeOffset": "-10%" },
        { "id": "VO_SM_24", "text": "……区块排除。第三步。", "emotion": "专注·分析", "type": "short" },
        { "id": "VO_SM_28", "text": "……这三个数，可以交换位置。但它们不会离开这三个格子。", "emotion": "专注·分析", "type": "normal" },
        { "id": "VO_SM_32", "text": "……外层31。内层12。差值是19。这三格——只能是4、6、9。", "emotion": "专注·计算", "type": "normal" },
        { "id": "VO_SM_36", "text": "……他一直在这里。不是作为谜题。是作为终点。", "emotion": "低沉·领悟", "type": "core" },
        { "id": "VO_SM_40", "text": "……错误不在链条，在迷信链条的心。", "emotion": "低沉·领悟", "type": "normal" },
        { "id": "VO_SM_42", "text": "……三十年。不算晚。", "emotion": "低沉·确认", "type": "core" },
        { "id": "VO_SM_46", "text": "……网撒下去的时候，鱼已经不在水里了。", "emotion": "低沉·领悟", "type": "normal" },
        { "id": "VO_SM_47", "text": "……这封信，是你写的吗？", "emotion": "低沉·质问", "type": "normal" }
      ]
    },
