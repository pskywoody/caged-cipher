          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "三子连阵，锁数成局。三格共享三数时，可排除该区域其他格子的这三个数字。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "三个格子加起来只有三个数字！",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_J_02",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "每一格不需要都有三个候选。只要它们共用三个数就行。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他已经把三个数圈了出来，然后看了很久。他的笔悬在纸上，没有落下去——像在等一个确认。）……这三个数，可以交换位置。但它们不会离开这三个格子。",
              "side": "left",
              "emotion": "calm",
              "voiceId": "VO_SM_28",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "三子法已通。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_CK_06",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "锁住三个格子，排除其他位置——感觉像在布阵！",
              "side": "right",
              "emotion": "surprised",
              "voiceId": "VO_J_03",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（轻声）……设局人布阵的时候，也是这样想的。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            }
          ],
