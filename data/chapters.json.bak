          "preDialog": [
            {
              "speaker": "设局人",
              "text": "……你来了。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_01",
              "effect": 4
            },
            {
              "speaker": "阿妍",
              "text": "（看着残影，没有后退）……来了。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "这不是教学卷。这是我三十年前为自己设下的终极考验——一道需要同时运用并蒂锁、三子法、二连纵横阵和三才游鱼阵才能解开的笼局。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_03",
              "effect": 3
            },
            {
              "speaker": "设局人",
              "text": "我花了三天三夜才解开它。如果你能独立完成——你就不再是我的学生，而是与我并列的设局者。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_04",
              "effect": 3
            },
            {
              "speaker": "莹莹",
              "text": "三天三夜？！这也太难了吧……",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（声音很轻，但很稳）……最后一道了。开始吧。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_13",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他站在残影面前。没有后退。他看着那个半透明的轮廓，声音很低，像是在确认什么）……这封信，是你写的吗？",
              "side": "left",
              "emotion": "sad",
              "voiceId": "VO_SM_47",
              "effect": 1
            },
            {
              "speaker": "旁白",
              "text": "（他从口袋里取出一封信——不是设局人暗格里的那封，是他自己收到的那封。）",
              "isNarration": true
            },
            {
              "speaker": "设局人",
              "text": "……不是我写的。是另一个人。但那封信，是我让她写的。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_05",
              "effect": 4
            }
          ],
          "clearDialog": [
            {
              "speaker": "设局人",
              "text": "……你做到了。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_06",
              "effect": 4
            },
            {
              "speaker": "设局人",
              "text": "星辰梭的奥义，从来不是某一种构型、某一条规则。它是一种信念——在混沌的数字迷雾中，永远存在着秩序，等待被发现。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_07",
              "effect": 3
            },
            {
              "speaker": "设局人",
              "text": "从今以后，你就是新的设局人。档案馆、星辰梭、还有这六卷秘术——都交给你了。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_08",
              "effect": 3
            },
            {
              "speaker": "阿妍",
              "text": "（看着残影渐渐淡去，没有移开目光）……你等了多久？",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "（停顿了一下，声音变得很轻）……等你问这个问题，等了很久。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_09",
              "effect": 2
            },
            {
              "speaker": "旁白",
              "text": "（残影彻底消散。）",
              "isNarration": true
            },
            {
              "speaker": "莹莹",
              "text": "（在阿妍身边，声音很轻）阿妍姐……你好像早就认识他。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（沉默了很久）……不。我不认识他。我只是认识他留下来的所有东西。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            },
            {
              "speaker": "守笼人",
              "text": "恭喜你，秘术大师。七章全部完成。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_CK_06",
              "effect": 2
            },
            {
              "speaker": "阿妍",
              "text": "（轻声）……七章。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他站在暗格前，手里握着那封自己带来的信。他看了看暗格里那封“写给女儿”的信，又看了看自己手里的信——不是同一封。但折纸的方式，一模一样。）",
              "side": "left",
              "emotion": "sad",
              "voiceId": "VO_SM_48",
              "effect": 1
            }
          ],
          "isBoss": true,
          "mode": "endgame",
          "isClassic": true,
          "breakPointIndex": null,
          "totalSteps": 55,
          "targetTechnique": "mixed"
        },
