      }
    ],
    "setter_battle": [
      {
        "speaker": "设局人（秘术）",
        "text": "……你做到了。",
        "emotion": "smile",
        "effect": 4
      }
    ],
    "setter_broken": [
      {
        "speaker": "设局人（秘术）",
        "text": "星辰梭的奥义，从来不是某一种构型、某一条规则。它是一种信念——在混沌的数字迷雾中，永远存在着秩序，等待被发现。",
        "emotion": "serious",
        "effect": 3
      }
    ],
    "setter_broken2": [
      {
        "speaker": "设局人（秘术）",
        "text": "从今以后，你就是新的设局人。档案馆、星辰梭、还有这六卷秘术——都交给你了。",
        "emotion": "smile",
        "effect": 3
      }
    ],
    "setter_defeat": [
      {
        "speaker": "设局人（秘术）",
        "text": "（停顿了一下，声音变得很轻）……等你问这个问题，等了很久。",
        "emotion": "smile",
        "effect": 2
      },
      {
        "speaker": "设局人（秘术）",
        "text": "……你终于看到这里了。",
        "emotion": "smile",
        "effect": 3
      },
      {
        "speaker": "阿妍",
        "text": "我们赢了？！我们真的赢了设局人完全体？！",
        "emotion": "smile",
        "effect": 2
      }
    ],
    "setter_transfer": [
      {
        "speaker": "设局人（秘术）",
        "text": "不必叫我老师。当你能看懂三才游鱼阵的那一刻，你已经超越了我当年的水平。",
        "emotion": "smile",
        "effect": 2
      },
      {
        "speaker": "守笼人",
        "text": "（微微点头）恭喜你，真正的大师。",
        "emotion": "smile",
        "effect": 2
      }
    ],
    "setter_farewell": [
      {
        "speaker": "设局人（秘术）",
        "text": "但记住——技巧是死的，洞察是活的。星辰梭的真正奥义，从来不是某一种固定的构型，而是在混沌中看见秩序的眼睛。",
        "emotion": "smile",
        "effect": 3
      }
    ],
    "true_ending": [
