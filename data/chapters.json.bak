          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "第一卷——并蒂锁。双星并蒂，闭户成局。两个格子共享两个候选数时，它们形成一把“锁”。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "我明白了！比如两个格子都只能是3和7！",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_J_02",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "并蒂锁的意义不在于填它们自己。而在于排除其他格子的可能性。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            },
            {
              "speaker": "守笼人",
              "text": "正是。数对是所有高阶技巧的基础。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他看着棋盘上那两个互锁的格子，看了一会儿。然后他轻声说）……锁住两个数，排除掉其他地方。剩下的就是答案了。",
              "side": "left",
              "emotion": "thinking",
              "voiceId": "VO_SM_32",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "设局人（秘术）",
              "text": "并蒂锁——第一卷秘术。你学得很快。",
              "side": "right",
              "emotion": "smirk",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "……这只是开始。",
              "side": "left",
              "emotion": "calm",
              "effect": 0
            }
