          "triggers": [
            {
              "id": "t107_s",
              "condition": "onLevelStart",
              "type": "freeze_mask",
              "text": "大招来了！「10法则」：4×4每行/列/宫总和永远是10（1+2+3+4=10）！用10减已知数，就能算出剩下的！",
              "once": true,
              "targetR": 0,
              "targetC": 0,
              "targetType": "cell",
              "highlightShape": "circle"
            },
            {
              "id": "t107_b",
              "condition": "onFillCountReached",
              "count": 6,
              "type": "enter_phase",
              "phase": "breakthrough",
              "once": true
            },
            {
              "id": "t107_st",
              "condition": "onStuckForSeconds",
              "seconds": 25,
              "type": "popup_hint",
              "position": "top",
              "text": "💡 看第一行！10-4-2=4，再看笼子和值是4，就知道两个数是1和3！",
              "once": false
            },
            {
              "id": "t107_fi",
              "condition": "onFillCountReached",
              "count": 12,
              "type": "enter_phase",
              "phase": "finishing",
              "once": true
            }
          ],
          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "4×4盘面里，每一行、每一列、每个宫格的总和都恒为十——是谓“十则”。",
              "side": "right",
              "sfx": "playFootstep",
              "voiceId": "VO_CK_05",
              "emotion": "default",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "十！十！十！我把它刻脑门上了——后来洗脸洗掉了，又忘了三次！",
              "side": "right",
              "voiceId": "VO_J_02",
              "emotion": "confident",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "……记住就行了。不用刻。",
              "side": "right",
              "voiceId": "VO_R_007",
              "emotion": "calm",
              "effect": 0
            },
            {
              "speaker": "守笼人",
              "text": "提示数比上一关多了一些，但有陷阱。你能找到它吗？不要只看和值——要验证每一条线。",
              "side": "right",
              "voiceId": "VO_CK_05",
              "emotion": "default",
              "effect": 1
            },
            {
              "speaker": "守笼人",
              "text": "看到了吗？表面是对的，但验证后发现不对。十则不是终点——是起点。",
              "side": "right",
              "voiceId": "VO_CK_06",
              "emotion": "smile",
              "effect": 0
            },
            {
              "speaker": "旁白",
              "text": "沈墨已经把行、列、宫各自的和默算了一遍，轻声说",
              "isNarration": true
            }
          ],
          "clearDialog": [
            {
              "speaker": "沈墨",
              "text": "……“十。每一行都是十。”",
              "side": "left",
              "voiceId": "VO_SM_08",
              "emotion": "default",
              "effect": 0
            },
            {
              "speaker": "守笼人",
              "text": "十则之术已破。你离真正的笼局又近了一步。",
              "side": "right",
              "voiceId": "VO_CK_06",
              "emotion": "smile",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "又近了一步！我当初数过——训练关一共112次！",
              "side": "right",
              "voiceId": "VO_J_09",
              "emotion": "confident",
              "effect": 1
            },
            {
              "speaker": "旁白",
              "text": "阿妍第一次对莹莹的话有了直接回应",
              "isNarration": true
            },
            {
              "speaker": "阿妍",
              "text": "……112次。你还数了。",
              "side": "right",
              "voiceId": "VO_R_007",
              "emotion": "calm",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "当然！我爸说过——每一步都算数。",
              "side": "right",
              "voiceId": "VO_J_05",
              "emotion": "default",
              "effect": 0
            }
          ]
        },
