          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "这是星辰梭的基础形态——双层嵌套笼。大笼之中套着小笼，两层笼的和值与数字规则同时生效。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "先算外层还是先算内层？",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_07",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "从外到内。先解外层，再拆内层。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "从外到内，层层剥离。这是星辰梭教给你的第一课。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_01",
              "effect": 3
            },
            {
              "speaker": "阿妍",
              "text": "（头也不抬）……你说过了。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他已经在算外层笼的和值。没有抬头，但他的声音很轻）……外层31。内层12。差值是19。这三格——只能是4、6、9。",
              "side": "left",
              "emotion": "thinking",
              "voiceId": "VO_SM_32",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "双层嵌套只是基础。真正的星辰梭笼局，可以有无数层。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "无数层？那岂不是永远解不完？",
              "side": "right",
              "emotion": "surprised",
              "voiceId": "VO_J_03",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "所以才有趣，不是吗？",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_02",
              "effect": 2
            },
            {
              "speaker": "阿妍",
              "text": "（轻声）……有趣。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            }
          ],
