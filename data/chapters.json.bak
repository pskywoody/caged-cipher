          "preDialog": [
            {
              "speaker": "设局人",
              "text": "第二道，是我们认识第三年的对局。那时候我们天天泡在档案馆里。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_07",
              "effect": 2
            },
            {
              "speaker": "莹莹",
              "text": "听起来你们当年关系很好……",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（轻声）……关系越好，裂痕越深。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "……你倒是比守笼人看得透。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_03",
              "effect": 2
            },
            {
              "speaker": "阿妍",
              "text": "（头也不抬）陈述事实而已。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_02",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他听到了阿妍说“裂痕越深”。他没有说话，但他的笔在纸上停了一下——像是在想什么，又像是在确认什么。）",
              "side": "left",
              "emotion": "calm",
              "voiceId": "VO_SM_39",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "裂痕再深，也有被补上的一天。",
              "side": "right",
              "emotion": "smile",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "……说得好像你补过似的。",
              "side": "right",
              "emotion": "calm",
              "effect": 0
            }
          ],
