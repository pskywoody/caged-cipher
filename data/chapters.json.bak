          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "这是当年决裂那天留下的第一份残局档案。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "碎片拼真相……就像我爸留下的那些纸片。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（翻开笔记，目光停在一页上）……第三手。他用的是区块排除。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "你怎么知道是第三手？",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_07",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（合上笔记，声音平稳）……因为这份笔记的第一页只有三行字。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_02",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他看了一眼阿妍指的位置，几乎没有停顿）……区块排除。第三步。",
              "side": "left",
              "emotion": "thinking",
              "voiceId": "VO_SM_24",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "残局逆向推导——碎片摆在那，反推全局。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_CK_06",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "从碎纸片里拼出真相……",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（翻开笔记，轻声念出）……“第三手，他用了区块排除——守笼人愣了。”……写得很准。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他在听阿妍念出那句话的时候，目光落在了笔记边缘的空白处。那里有一行极小的铅笔字，被擦掉过很多次。他看不清全部——但最后一个字还能辨认：是一个“等”字。）",
              "side": "left",
              "emotion": "calm",
              "voiceId": "VO_SM_25",
              "effect": 0
            }
          ],
