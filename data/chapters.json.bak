          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "这是星辰梭的高阶形态——嵌套、异形、多组联动同时存在。提示数降至二十六个。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_CK_09",
              "effect": 3
            },
            {
              "speaker": "莹莹",
              "text": "二十六个……感觉整张盘都是空的！",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "空，才是星辰梭的本质。你以为你在填数字，其实你是在从无中创造有。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_02",
              "effect": 3
            },
            {
              "speaker": "阿妍",
              "text": "（声音微微发紧）……你说过了。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（恢复平静）……开始吧。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_13",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "设局人",
              "text": "你解到这里，已经超越了当年的守笼人。他一辈子都不敢碰极限复合笼——他怕失控。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_04",
              "effect": 3
            },
            {
              "speaker": "守笼人",
              "text": "我不是怕失控。我是怕有人用它来做不该做的事。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_CK_10",
              "effect": 2
            },
            {
              "speaker": "阿妍",
              "text": "不该做的事……到底是什么事？",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_04",
              "effect": 1
            },
            {
              "speaker": "设局人",
              "text": "第六章的终局笼局里，有全部答案。你自己去看。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_05",
              "effect": 3
            }
          ],
