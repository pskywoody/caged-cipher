          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "两行两列形成一个矩形。找到四个角，就能排除其余。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "听起来像X形！",
              "side": "right",
              "emotion": "surprised",
              "voiceId": "VO_J_03",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "就是X形。四个顶点。两种可能。排除一切。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_02",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "能看懂二连纵横阵，勉强算摸到了星辰梭的门槛。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_04",
              "effect": 3
            },
            {
              "speaker": "阿妍",
              "text": "（看着棋盘，没有抬头）……嗯。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "当年，我就是用二连纵横阵为基础，推演出了第一套星辰梭笼局模型。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_CK_10",
              "effect": 2
            },
            {
              "speaker": "莹莹",
              "text": "你们当年……到底为什么决裂？",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "守笼人",
              "text": "（沉默了很久）……因为他走到了我不敢走的路。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_CK_10",
              "effect": 2
            },
            {
              "speaker": "阿妍",
              "text": "（替他说完了）……道不同。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_04",
              "effect": 1
            },
            {
              "speaker": "守笼人",
              "text": "第四章的残局档案，记录了我们决裂那天的最后一局。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_CK_10",
              "effect": 2
            }
          ],
