          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "本章全部星衡、笼格推演技巧融合在此，检验你能否抵御设局人的谜题陷阱。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_CK_09",
              "effect": 2
            },
            {
              "speaker": "莹莹",
              "text": "这一关把二十一、四十五、差值、嵌套笼全堆一起了！",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_10",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（看着棋盘，沉默了三秒，然后拿起笔）……开始吧。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_13",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他已经把第一行扫完了，几乎没有犹豫）……第一行第六列。2。",
              "side": "left",
              "emotion": "thinking",
              "voiceId": "VO_SM_12",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "你已吃透星衡全部基础。设局人留下的深层档案即将解锁。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_CK_06",
              "effect": 1
            },
            {
              "speaker": "设局人",
              "text": "能闯过星衡试炼，勉强有资格直面我真正的笼局。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_04",
              "effect": 2
            },
            {
              "speaker": "莹莹",
              "text": "我一定要解开所有谜题，搞懂你和守笼人当年到底发生了什么！",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_10",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（没有接话。但在转身走向下一层的时候，她的声音很轻地传来）……会的。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_03",
              "effect": 0
            }
          ],
          "mode": "comprehensive",
