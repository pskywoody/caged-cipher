          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "隐曜——群曜遮目，一光独隐。当某两个数字在某区域内只能放在相同的两个格子里时，这两个格子便被暗中标定。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "就是两个数偷偷约好只出现在两个格子里！",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_J_02",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "……它们不是约好的。是被挤到那里去的。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_02",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他看着棋盘上那两个被压到角落的格子。没有抬头，声音很低）……就像人一样。",
              "side": "left",
              "emotion": "sad",
              "voiceId": "VO_SM_20",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "隐曜已通。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_CK_06",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "原来藏在候选数里的数字才是关键！",
              "side": "right",
              "emotion": "surprised",
              "voiceId": "VO_J_03",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "隐性数对比显性更难发现。但一旦找到，就打开了一片区域。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            }
          ],
