          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "九个数加起来永远是四十五。这是所有笼局的根。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "六阶二十一、九阶四十五！",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_J_02",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "四十五只是最表层的障眼法。真正的笼局玄机，藏在差值之中。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_02",
              "effect": 2
            },
            {
              "speaker": "阿妍",
              "text": "（这一次，她抬起了头）……差值。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 1
            },
            {
              "speaker": "阿妍",
              "text": "（声音很轻，像在自言自语）他用差值藏了最后的答案。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他看着棋盘，没有抬头。但他的声音比平时清晰了一点）……藏的不是答案。藏的是——指向答案的路。",
              "side": "left",
              "emotion": "calm",
              "voiceId": "VO_SM_15",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "吃透四十五法则，才有资格拆解设局人留下的差值笼。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_CK_06",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "差值笼……听起来好难。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "差值就是减法。两层笼子的数相减，剩下的就是那几格该填的。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_02",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "……你说得好简单。",
              "side": "right",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "因为本来就不复杂。",
              "side": "right",
              "emotion": "determined",
              "voiceId": "VO_R_13",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（安静地看了棋盘一眼）……四十五。",
              "side": "left",
              "emotion": "thinking",
              "voiceId": "VO_SM_08",
              "effect": 0
            }
          ],
