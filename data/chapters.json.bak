          "preDialog": [
            {
              "speaker": "设局人",
              "text": "这就是最后一道笼局——「星辰之心」。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_10",
              "effect": 3
            },
            {
              "speaker": "守笼人",
              "text": "（倒吸一口凉气）这……这道题的难度——",
              "side": "right",
              "emotion": "surprised",
              "voiceId": "VO_CK_10"
            },
            {
              "speaker": "设局人",
              "text": "它不是最难的。但它是最「真」的。因为解开它的钥匙，不在规则里，不在技巧里——而在你自己心里。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_11",
              "effect": 2
            },
            {
              "speaker": "莹莹",
              "text": "（深吸一口气）我准备好了。",
              "side": "right",
              "emotion": "confident",
              "voiceId": "VO_J_05"
            },
            {
              "speaker": "沈墨",
              "text": "（点头）……开始吧。",
              "side": "left",
              "emotion": "calm",
              "voiceId": "VO_SM_05"
            },
            {
              "speaker": "阿妍",
              "text": "（微微一笑）那就——让我们看看，最后一道锁的后面，是什么。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_R_03"
            }
          ],
          "clearDialog": [
            {
              "speaker": "旁白",
              "text": "最后一个数字落下。整个大厅被金色的光芒笼罩。星辰之心，解开了。",
              "isNarration": true,
              "effect": 3
            },
            {
              "speaker": "设局人",
              "text": "（身影变得前所未有的清晰）……你们做到了。",
              "side": "right",
              "emotion": "smirk",
              "voiceId": "VO_SS_11",
              "effect": 3
            },
            {
              "speaker": "设局人",
              "text": "从今天起，星辰梭的秘密——由你们来守护。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_SS_12",
              "effect": 2
            }
          ],
          "isBoss": true,
          "mode": "endgame"
        }
      ],
