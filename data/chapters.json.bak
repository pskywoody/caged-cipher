    "ch7_lvl6_before": [
      {
        "speaker": "设局人（秘术）",
        "text": "尘埃落定之时，星辰梭的光芒将再次显现。",
        "emotion": "serious",
        "effect": 4
      },
      {
        "speaker": "阿妍",
        "text": "（正在翻书，没有抬头，但嘴角微微动了一下）嗯。看到了。"
      },
      {
        "speaker": "设局人（秘术）",
        "text": "这不是教学卷。这是我三十年前为自己设下的终极考验——一道需要同时运用并蒂锁、三子法、二连纵横阵和三才游鱼阵才能解开的笼局。",
        "emotion": "serious",
        "effect": 3
      },
      {
        "speaker": "设局人（秘术）",
        "text": "我花了三天三夜才解开它。如果你能独立完成——你就不再是我的学生，而是与我并列的设局者。",
        "emotion": "serious",
        "effect": 3
      },
      {
        "speaker": "莹莹",
        "text": "笼锁……终于来了。我爸留下的那些图，全都是这种虚线框。",
        "emotion": "sad"
      },
      {
        "speaker": "阿妍",
        "text": "（合上手中的书，终于走向棋盘）长按数字可以连填。省事。"
      },
      {
        "speaker": "沈墨",
        "text": "（他站在残影面前。没有后退。他看着那个半透明的轮廓，声音很低，像是在确认什么）……这封信，是你写的吗？",
        "emotion": "serious",
        "effect": 1
      },
      {
        "speaker": "设局人（秘术）",
        "text": "……不是我写的。是另一个人。但那封信，是我让她写的。",
        "emotion": "serious",
        "effect": 4
      }
    ],
