          "triggers": [
            {
              "id": "t502_s",
              "condition": "onLevelStart",
              "type": "popup_hint",
              "position": "top",
              "text": "第二关：异形笼！这一关的笼子形状不规则，像蜿蜒的蛇一样穿过多个宫——关键是拆分它们！",
              "once": true
            },
            {
              "id": "t502_f1",
              "condition": "onFirstNumberFilled",
              "type": "popup_hint",
              "position": "top",
              "text": "好！异形笼虽然看起来复杂，但拆分成几段后，每段都可以用星衡法则或组合分析！",
              "once": true
            },
            {
              "id": "t502_b",
              "condition": "onFillCountReached",
              "count": 51,
              "type": "enter_phase",
              "phase": "breakthrough",
              "once": true
            },
