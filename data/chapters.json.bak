  "scenes": {
    "ch1_opening": [
      {
        "speaker": "守笼人",
        "text": "欢迎来到数字档案馆。我是守笼人。这里记录着所有被锁住的数字，也记录着被锁住的过去。",
        "emotion": "serious",
        "effect": 2
      },
      {
        "speaker": "守笼人",
        "text": "无论你们各自抱着什么目的而来，在这间档案馆里，规则是第一位的。",
        "emotion": "serious",
        "effect": 1
      },
      {
        "speaker": "守笼人",
        "text": "第一道档案锁遵循行规则：同一横排数字1-4不可重复。",
        "emotion": "serious"
      },
      {
        "speaker": "守笼人",
        "text": "解开它们，你就能找到真相。",
        "emotion": "serious"
      }
    ],
    "ch1_opening_full": [
      {
        "type": "title",
        "text": "第一章",
        "subtitle": "初识笼中密码"
      },
      {
        "speaker": "旁白",
        "text": "你推开尘封三十年的档案馆大门，空气中弥漫着旧纸张的气息。一封匿名信带你来到这里——信上只有一行字：\"档案编号K-734。如果你能解开这一局，就能找到我。\"",
        "sfx": "playDoorOpen"
      },
      {
        "speaker": "沈墨",
        "text": "（站在门口，看了信最后一眼，将信折好放进口袋。他走进门内。）",
        "emotion": "think",
        "sfx": {
          "name": "playFootstep",
          "args": [
            3
          ],
          "delay": 100
        }
      },
      {
        "speaker": "沈墨",
        "text": "……好。",
        "effect": 1
      },
      {
        "speaker": "守笼人",
        "text": "（从阴影中走出，脚步声在空旷的大厅中回响）",
        "sfx": {
          "name": "playFootstep",
          "args": [
            5
          ],
          "delay": 200
        }
      },
      {
        "speaker": "守笼人",
        "text": "欢迎来到数字档案馆。我是守笼人。这里记录着所有被锁住的数字，也记录着被锁住的过去。",
        "emotion": "serious",
        "effect": 2
      },
      {
        "speaker": "莹莹",
        "text": "（从书架后探出头，手里抱着一本比她脸还大的旧册子）",
        "emotion": "energetic"
      },
      {
        "speaker": "莹莹",
        "text": "哇！来新人啦！我叫莹莹，比你早到两个月！",
        "emotion": "energetic"
      },
      {
        "speaker": "莹莹",
        "text": "这地方特——别——大——我第一天来的时候为了找厕所，在里面迷路了三天三夜！",
        "emotion": "energetic"
      },
      {
        "speaker": "阿妍",
        "text": "（从书架另一侧走出，手里拿着一支笔，没抬头）",
        "sfx": {
          "name": "playPaperFlip",
          "delay": 100
        }
      },
      {
        "speaker": "阿妍",
        "text": "阿妍。比你早来三周。"
      },
      {
        "speaker": "阿妍",
        "text": "（合上笔记，终于看向沈墨）在看你的资料。委托人信上的内容，我已经确认过了——是真的。这间档案馆确实藏着什么。"
      },
      {
        "speaker": "守笼人",
        "text": "无论你们各自抱着什么目的而来，在这间档案馆里，规则是第一位的。",
        "emotion": "serious",
        "effect": 1
      },
      {
        "speaker": "守笼人",
        "text": "从今天起，你们将从最基础的4×4盘面学起。每行、每列、每个2×2小宫格里，数字只能出现一次。",
        "emotion": "serious"
      },
      {
        "speaker": "莹莹",
        "text": "（举手）报告！我已经能背了！第二项：每行每列数字不重复！第三项：2×2宫格数字不重复！",
        "emotion": "confident"
      },
      {
        "speaker": "守笼人",
        "text": "（看了她一眼）……准备好了吗？",
        "sfx": "playSigh"
      }
    ],
    "before_tutorial": [
      {
        "speaker": "守笼人",
        "text": "第一道档案锁遵循行规则：同一横排数字1-4不可重复。",
        "emotion": "serious"
      },
      {
        "speaker": "守笼人",
        "text": "解开它们，你就能找到真相。",
        "emotion": "serious"
      }
    ],
    "first_correct": [
      {
        "speaker": "守笼人",
        "text": "基础铁律你已吃透。接下来，真正的笼锁谜题即将出现。",
        "emotion": "serious",
        "effect": 1
      }
    ],
    "level_clear_ch1": [
      {
        "speaker": "守笼人",
        "text": "能解开基础行锁，说明你至少具备了最基本的观察力。",
        "emotion": "smile"
      }
    ],
    "breakthrough": [
      {
        "speaker": "守笼人",
        "text": "双格笼是最基础的笼型，可直接根据和值锁定仅有的数字组合。记住——三取一二，四取一三，六取二四，七取三四。",
        "emotion": "serious",
        "effect": 1
      }
    ],
    "advanced_tech": [
      {
        "speaker": "守笼人",
        "text": "多重笼格交错时，需要同时兼顾行、列、宫与笼和四条约束。记住——“群曜遮目，一光独隐”。",
        "emotion": "serious",
        "effect": 1
      }
    ],
    "before_hint": [
      {
        "speaker": "守笼人",
        "text": "本章最终考核，检验你所有基础笼局推理能力——孤星、隐曜、并蒂锁、三子法、十则之术。",
        "emotion": "serious",
        "effect": 2
      }
    ],
    "ch1_boss": [
      {
        "speaker": "阿妍",
        "text": "阿妍。比你早来三周。"
      },
      {
        "speaker": "阿妍",
        "text": "缺哪个数，就是哪个。",
        "effect": 1
      }
    ],
    "ch2_opening": [
      {
        "speaker": "守笼人",
        "text": "能解开基础行锁，说明你至少具备了最基本的观察力。",
        "emotion": "smile"
      },
      {
        "speaker": "守笼人",
        "text": "多重笼格交错时，需要同时兼顾行、列、宫与笼和四条约束。记住——“群曜遮目，一光独隐”。",
        "emotion": "serious",
        "effect": 1
      }
    ],
    "ch2_boss": [
      {
        "speaker": "守笼人",
        "text": "看来，是时候考验你真正的实力了。",
        "emotion": "serious",
        "effect": 3
      },
      {
        "speaker": "守笼人",
        "text": "作为你的导师，我不会手下留情。",
        "emotion": "serious",
        "effect": 3
      }
    ],
    "cagekeeper_defeat": [
      {
        "speaker": "守笼人",
        "text": "你……竟然做到了这一步。",
        "emotion": "surprised",
        "effect": 2
      },
      {
        "speaker": "守笼人",
        "text": "很好，你已经超越了我。去揭开真相吧。",
        "effect": 2
      }
    ],
    "ch3_boss": [
      {
        "speaker": "设局人残影",
        "text": "你以为……这就是真相？",
        "emotion": "smirk",
        "effect": 3
      },
      {
        "speaker": "设局人残影",
        "text": "我留下的残影，只是开始。",
        "effect": 3
      }
    ],
    "shadow_defeat": [
      {
        "speaker": "设局人残影",
        "text": "……残影被看穿了？",
        "emotion": "surprised",
        "effect": 2
      },
      {
        "speaker": "设局人残影",
        "text": "有意思。继续往前走吧……",
        "effect": 2
      }
    ],
    "ch4_boss": [
      {
        "speaker": "残局守护者",
        "text": "残局已激活。",
        "effect": 4
      },
      {
        "speaker": "残局守护者",
        "text": "验证开始。",
        "effect": 3
      }
    ],
    "ch5_boss": [
      {
        "speaker": "星辰梭",
        "text": "我就是星辰梭。",
        "effect": 3
      },
      {
        "speaker": "星辰梭",
        "text": "穿梭于逻辑之间的织网者。",
        "effect": 3
      }
    ],
    "ch6_boss": [
      {
        "speaker": "守笼人",
        "text": "我没想到……他竟然会走到那一步。",
        "emotion": "sad"
      },
      {
        "speaker": "设局人",
        "text": "只会死守二十一星衡，你永远破不开我完整的九域笼局。",
        "effect": 3
      },
      {
        "speaker": "设局人",
        "text": "四十五只是最表层的障眼法。真正的笼局玄机，藏在差值之中。",
        "emotion": "think",
        "effect": 2
      }
    ],
    "ch7_final": [
      {
        "speaker": "设局人（秘术）",
        "text": "尘埃落定之时，星辰梭的光芒将再次显现。",
        "emotion": "serious",
        "effect": 4
      },
      {
        "speaker": "设局人（秘术）",
        "text": "当年我布下这道题，就是想问守笼人一个问题——如果一道题有两个正确答案，你选哪一个？",
        "emotion": "serious",
        "effect": 4
      },
      {
        "speaker": "阿妍",
        "text": "（第一次对莹莹说了句带温度的话）……你哪关不是哭着过的。"
      },
      {
        "speaker": "守笼人",
        "text": "小心。这是他真正的实力，不要留手。",
        "emotion": "serious",
        "effect": 2
      },
      {
        "speaker": "设局人（秘术）",
        "text": "这不是教学卷。这是我三十年前为自己设下的终极考验——一道需要同时运用并蒂锁、三子法、二连纵横阵和三才游鱼阵才能解开的笼局。",
        "emotion": "serious",
        "effect": 3
      },
      {
        "speaker": "设局人（秘术）",
        "text": "我花了三天三夜才解开它。如果你能独立完成——你就不再是我的学生，而是与我并列的设局者。",
        "emotion": "serious",
        "effect": 3
      }
    ],
    "ray_boss_intro": [
      {
        "speaker": "阿妍",
        "text": "阿妍。比你早来三周。"
      }
    ],
    "ray_boss_start": [
      {
        "speaker": "阿妍",
        "text": "缺哪个数，就是哪个。",
        "effect": 1
      }
    ],
    "ray_stuck": [
      {
        "speaker": "阿妍",
        "text": "（依然没有靠近棋盘，但声音比之前低了一点）不错。继续。",
        "emotion": "smile"
      }
    ],
    "ray_break": [
      {
        "speaker": "阿妍",
        "text": "（从窗边转过身来，声音很轻）……设局人。",
        "emotion": "serious",
        "effect": 1
      }
    ],
    "ray_break2": [
      {
        "speaker": "阿妍",
        "text": "（已经转身走向下一扇门）……走了。"
      }
    ],
    "ray_tied": [
      {
        "speaker": "阿妍",
        "text": "（目光掠过莹莹的笔记本，停顿了极短的一瞬）你父亲是这里的档案员？"
      },
      {
        "speaker": "阿妍",
        "text": "（正在翻书，没有抬头，但嘴角微微动了一下）嗯。看到了。"
      }
    ],
    "ray_defeat": [
      {
        "speaker": "阿妍",
        "text": "（已经回到书架前，语气平淡）高不高手，还早。"
      },
      {
        "speaker": "阿妍",
        "text": "算你厉害……",
        "emotion": "lose",
        "effect": 2
      }
    ],
    "ray_after": [
      {
        "speaker": "阿妍",
        "text": "后面还有更难的！",
        "emotion": "angry"
      }
    ],
    "mention_plotter": [
      {
        "speaker": "守笼人",
        "text": "……一个曾经和我站在一起的人。他的名字，已被从所有档案里抹去了。",
        "emotion": "serious",
        "effect": 2
      }
    ],
    "remnant_enter": [
      {
        "speaker": "残局守护者",
        "text": "残局已激活。",
        "effect": 4
      },
      {
        "speaker": "残局守护者",
        "text": "验证开始。",
        "effect": 3
      }
    ],
    "remnant_break": [
      {
        "speaker": "残局守护者",
        "text": "检测到异常逻辑输入。",
        "emotion": "stern",
        "effect": 2
      }
    ],
    "remnant_reject": [
      {
        "speaker": "残局守护者",
        "text": "拒绝。",
        "emotion": "stern",
        "effect": 1
      }
    ],
    "remnant_defeat": [
      {
        "speaker": "残局守护者",
        "text": "残局……被破解。",
        "emotion": "surprised",
        "effect": 4
      },
      {
        "speaker": "残局守护者",
        "text": "逻辑崩塌中……",
        "emotion": "surprised",
        "effect": 4
      }
    ],
    "weaver_enter": [
      {
        "speaker": "星辰梭",
        "text": "我就是星辰梭。",
        "effect": 3
      },
      {
        "speaker": "星辰梭",
        "text": "穿梭于逻辑之间的织网者。",
        "effect": 3
      }
    ],
    "weaver_tech": [
      {
        "speaker": "星辰梭",
        "text": "你以为这就结束了？",
        "emotion": "smirk",
        "effect": 1
      },
      {
        "speaker": "星辰梭",
        "text": "远着呢。",
