          "preDialog": [
            {
              "speaker": "设局人",
              "text": "第三道，是我们第一次吵架那天的对局。我发现星辰梭可以推演更复杂的系统，不只是数独。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_04",
              "effect": 3
            },
            {
              "speaker": "守笼人",
              "text": "推演市场走势、推演人群决策、推演……战争胜负。星辰梭的边界一旦打开，后果不堪设想。",
              "side": "right",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "居然还能推演这些……",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（低声）……它还能推演别的东西。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            },
            {
              "speaker": "设局人",
              "text": "那一架吵了三天三夜。最后他说——如果你坚持走这条路，我们就不再是同门。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_05",
              "effect": 3
            },
            {
              "speaker": "守笼人",
              "text": "……我曾以为，那样能拦住他。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_CK_10",
              "effect": 2
            },
            {
              "speaker": "设局人",
              "text": "你拦不住我。因为工具从不会犯错，只有人才会。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_P_05",
              "effect": 3
            }
          ],
          "clearDialog": [
            {
              "speaker": "莹莹",
              "text": "哇——这么复杂的推理也能串起来！",
              "side": "right",
              "emotion": "energetic",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "……一步错，步步错。还好，每一步都对了。",
              "side": "left",
              "emotion": "calm",
              "effect": 0
            }
          ],
