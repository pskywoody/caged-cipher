          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "多个区块同时作用时，需要综合判断，这是设局人最擅长的布局手法。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "好几个区块叠在一起看着乱，一个一个拆开来分析就清楚了。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_J_02",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "……他喜欢把多条线索叠在一起。然后在交叉点埋下陷阱。",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他看着棋盘上三条线索的交汇点，手指停在了那里——没有填，只是停在那里。然后他说）……他布的局，不是让人看不见答案。是让人看不见自己走过了几条线。",
              "side": "left",
              "emotion": "calm",
              "voiceId": "VO_SM_19",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "守笼人",
              "text": "这种多区块交错的笼型，正是当年他最得意的作品。",
              "side": "right",
              "emotion": "mysterious",
              "voiceId": "VO_CK_05",
              "effect": 1
            },
            {
              "speaker": "莹莹",
              "text": "当年……你和设局人当年到底发生了什么？",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_J_05",
              "effect": 0
            },
            {
              "speaker": "守笼人",
              "text": "……当年我们曾是同门，一起研究星辰梭推演笼局的极限。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_CK_10",
              "effect": 2
            },
            {
              "speaker": "阿妍",
              "text": "（停顿了一下，声音比平时轻）……研究了多久？",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07",
              "effect": 0
            },
            {
              "speaker": "守笼人",
              "text": "……十三年。",
              "side": "right",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "（没有再问）",
              "side": "right",
              "effect": 0
            },
            {
              "speaker": "沈墨",
              "text": "（他听到了“十三年”。没有说话，但他的笔在纸上停了一瞬，然后继续。）",
              "side": "left",
              "effect": 0
            }
          ],
