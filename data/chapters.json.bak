              "side": "right"
            },
            {
              "speaker": "旁白",
              "text": "阿妍眼神微微一变",
              "isNarration": true
            }
          ],
          "clearDialog": [
            {
              "speaker": "阿妍",
              "text": "……你看出来了？",
              "side": "right",
