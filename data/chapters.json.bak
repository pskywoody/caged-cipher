      "prologue": [
        {
          "speaker": "守笼人",
          "text": "这里是手稿室。从本章开始，你将接触六阶与九阶盘面。",
          "side": "right",
          "emotion": "mysterious",
          "voiceId": "VO_CK_05",
          "effect": 0,
          "bg": "assets/images/backgrounds/bg_scene13.jpg"
        },
        {
          "speaker": "莹莹",
          "text": "六阶每行和是二十一，九阶直接变四十五！记牢这两个数，后面算笼子全靠它！",
          "side": "right",
          "emotion": "smile",
          "voiceId": "VO_J_02",
          "effect": 0
        },
        {
          "speaker": "阿妍",
          "text": "（已经站在书架前，手指滑过一本旧书背面的编号）……这些手稿的排布方式，不是随机的。",
          "side": "right",
          "emotion": "thinking",
          "voiceId": "VO_R_06",
          "effect": 0
        },
        {
          "speaker": "莹莹",
          "text": "什么意思？",
          "side": "right",
          "effect": 0
        },
        {
          "speaker": "阿妍",
          "text": "（收回手，转身）设局人离开之前，重新排过这间房间里的所有东西。他在给后来的人留记号。",
          "side": "right",
          "emotion": "thinking",
          "voiceId": "VO_R_06",
          "effect": 0
        },
        {
          "speaker": "守笼人",
          "text": "（第一次没有反驳）……你观察得很细。",
          "side": "right",
          "effect": 0
        },
        {
          "speaker": "阿妍",
          "text": "（没有回应）继续吧。",
          "side": "right",
          "emotion": "determined",
          "voiceId": "VO_R_10",
          "effect": 0
        }
      ],
      "epilogue": [
        {
          "speaker": "守笼人",
          "text": "你已吃透星衡全部基础。设局人留下的深层档案即将解锁。",
          "side": "right",
          "emotion": "smile",
          "voiceId": "VO_CK_06",
          "effect": 0,
          "bg": "assets/images/backgrounds/bg_scene22.jpg"
        },
        {
          "speaker": "莹莹",
          "text": "又过了一章！我感觉自己在爬楼梯——每上一层，风景都不一样！",
          "side": "right",
          "emotion": "surprised",
          "voiceId": "VO_J_03",
          "effect": 0
        },
        {
          "speaker": "阿妍",
          "text": "别高兴太早。下一层是档案室深层。",
          "side": "right",
          "emotion": "calm",
          "voiceId": "VO_R_05",
          "effect": 0
        },
        {
          "speaker": "莹莹",
          "text": "深层？有什么区别？",
          "side": "right",
          "emotion": "calm",
          "voiceId": "VO_J_05",
          "effect": 0
        },
        {
          "speaker": "阿妍",
          "text": "（声音沉了一点）……区别是，设局人自己设计了那层楼。这里的每一道墙、每一个书架、每一格数字——都是他亲手放进去的。",
          "side": "right",
          "emotion": "thinking",
          "voiceId": "VO_R_06",
          "effect": 0
        },
        {
          "speaker": "旁白",
          "text": "（安静。）",
          "isNarration": true
        },
        {
          "speaker": "守笼人",
          "text": "第三章的笼局，藏着设局人与我决裂的全部真相。",
          "side": "right",
          "emotion": "calm",
          "voiceId": "VO_CK_10",
          "effect": 2
        }
      ]
    },
    {
      "chapterId": 3,
      "title": "档案室深层",
      "subtitle": "进阶篇 · 9×9",
      "icon": "🕵️",
      "color": "#8b5cf6",
      "description": "深入档案馆深层，学习区块排除、数对法、二连纵横阵等进阶技巧。设局人正式现身对话，揭露当年与守笼人的同门过往。",
      "badgeId": "badge_c3_advanced",
      "badgeName": "中级侦探",
      "unlockRequirement": 2,
      "badge": {
        "id": "badge_c3_advanced",
        "name": "中级侦探",
        "icon": "🔑",
        "description": "掌握区块排除法与数对技巧，获得深入档案室深层的权限。"
      },
      "introStory": [
        {
          "type": "title",
          "text": "第三章",
          "subtitle": "档案室深层"
        },
        {
          "speaker": "守笼人",
          "text": "档案室深层的笼局，不再能靠简单星衡破解。你需要学会区块排除、数对法、二连纵横阵等进阶技巧。"
        },
        {
          "speaker": "阿妍",
          "text": "哇，这里的书架好高……感觉气氛都不一样了。"
        },
        {
          "speaker": "设局人",
          "text": "终于敢走进深层了？我还以为你会永远停留在二十一星衡的孩童游戏里。"
        },
        {
          "speaker": "阿妍",
          "text": "！！设局人？他居然直接说话了？"
        },
        {
          "speaker": "守笼人",
          "text": "……从本章开始，他会频繁出现。做好心理准备。"
        }
      ],
      "endingStory": [
        {
          "speaker": "守笼人",
          "text": "你已具备拆解设局人标准笼局的能力。"
        },
        {
          "speaker": "设局人",
          "text": "标准笼局？呵，你看到的不过是我三十年前的习作。"
        },
        {
          "speaker": "阿妍",
          "text": "三十年前？！这些谜题居然是三十年前的？"
        },
        {
          "speaker": "守笼人",
          "text": "三十年前，我与他因星辰梭的用途产生分歧。他想用星辰梭制造无解笼局，我认为笼局的意义是引导人思考。"
        },
        {
          "speaker": "设局人",
          "text": "道不同不相为谋。你守着你的档案馆，我布我的局。"
        },
        {
          "speaker": "守笼人",
          "text": "第四章的残局档案，记录了我们决裂那天的最后一局。"
        }
      ],
      "levels": [
