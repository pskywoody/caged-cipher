          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "第七道锁——笔记模式。遇到不确定的空格，可以把候选数字记下来，辅助推理。",
              "side": "right",
              "voiceId": "VO_CK_03",
              "emotion": "serious",
              "effect": 0
            },
            {
              "speaker": "守笼人",
              "text": "选中一个格子，在数字键盘上向上滑动，就能把数字记入笔记。也可以滑动选择多个格子，批量标记。",
              "side": "right",
              "voiceId": "VO_CK_03",
              "emotion": "serious",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "选中的格子会亮黄灯！这样你就知道哪些格子正在被编辑！",
              "side": "right",
              "voiceId": "VO_J_02",
              "emotion": "confident",
              "effect": 0
            },
            {
              "speaker": "阿妍",
              "text": "笔记是工具。不是答案本身。",
              "side": "right",
              "voiceId": "VO_R_013",
              "emotion": "calm",
              "effect": 0
            },
            {
              "speaker": "旁白",
              "text": "沈墨已经打开了笔记模式，在空格里标了几个候选数字，声音很低",
              "isNarration": true
            },
            {
              "speaker": "沈墨",
              "text": "……像在画地图。",
              "side": "left",
              "voiceId": "VO_SM_07",
              "emotion": "default",
              "effect": 0
            },
            {
              "speaker": "旁白",
              "text": "莹莹好奇",
              "isNarration": true
            },
            {
              "speaker": "莹莹",
              "text": "画地图？",
              "side": "right"
            },
            {
              "speaker": "旁白",
              "text": "沈墨没有抬头，继续标注",
              "isNarration": true
            },
            {
              "speaker": "沈墨",
              "text": "……把可能的路都标出来。然后走剩下那一条。",
              "side": "left"
            },
            {
              "speaker": "守笼人",
              "text": "来，试一次。选中任意空格，向上滑动数字键盘，标一个候选数。",
              "side": "right",
              "voiceId": "VO_CK_03",
              "emotion": "serious",
              "effect": 0
            }
          ],
          "clearDialog": [
            {
              "speaker": "旁白",
              "text": "【UI强制高亮：盘面上一个特定空格闪烁提示】",
              "isNarration": true
            },
            {
              "speaker": "旁白",
              "text": "【玩家操作：必须在该空格填入一个候选笔记，否则对话不推进】",
              "isNarration": true
            },
            {
              "speaker": "守笼人",
              "text": "笔记已成器。现在……这个空格就是靠笔记锁定的。",
              "side": "right",
              "voiceId": "VO_CK_06",
              "emotion": "smile",
              "effect": 0
            },
            {
              "speaker": "莹莹",
              "text": "你马上就要见到第一章的最后一关了。那关……我当时是哭着过的。",
              "side": "right",
              "voiceId": "VO_J_05",
              "emotion": "default",
              "effect": 0
            },
            {
              "speaker": "旁白",
              "text": "阿妍第一次对莹莹说了句带温度的话",
              "isNarration": true
            },
            {
              "speaker": "阿妍",
              "text": "……你哪关不是哭着过的。",
              "side": "right",
              "voiceId": "VO_R_011",
              "emotion": "default",
              "effect": 0
            },
            {
              "speaker": "旁白",
              "text": "莹莹愣住",
              "isNarration": true
            },
            {
              "speaker": "莹莹",
              "text": "阿妍姐你……你也会开玩笑？",
              "side": "right"
            },
            {
              "speaker": "旁白",
              "text": "阿妍已经转身走向下一扇门",
              "isNarration": true
            },
            {
              "speaker": "阿妍",
              "text": "……走了。",
              "side": "right",
              "voiceId": "VO_R_005",
              "emotion": "default",
              "effect": 0
            },
            {
              "speaker": "旁白",
              "text": "沈墨放下笔，看了一眼棋盘",
              "isNarration": true
            },
            {
              "speaker": "沈墨",
              "text": "……笔记已成器。",
              "side": "left",
              "voiceId": "VO_SM_09",
              "emotion": "calm",
              "effect": 0
            }
          ]
        },
