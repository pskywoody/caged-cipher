          "preDialog": [
            {
              "speaker": "守笼人",
              "text": "……你找到了。这是设局人藏在第一章档案里的密信。他说，只有全S级通关的人，才有资格看到。",
              "side": "right",
              "emotion": "surprised",
              "voiceId": "VO_CK_10"
            },
            {
              "speaker": "阿妍",
              "text": "（目光微动）……密信？",
              "side": "right",
              "emotion": "thinking",
              "voiceId": "VO_R_06"
            },
            {
              "speaker": "守笼人",
              "text": "这道笼局，没有任何提示数字。全凭笼格的和值来推导。他称之为——「无字之笼」。",
              "side": "right",
              "emotion": "serious",
              "voiceId": "VO_CK_02"
            },
            {
              "speaker": "莹莹",
              "text": "哇！一个提示数字都没有？！这能解吗？！",
              "side": "right",
              "emotion": "surprised",
              "voiceId": "VO_J_03"
            },
            {
              "speaker": "守笼人",
              "text": "星衡法则，加上唯一组合——已经足够了。试试看吧。",
              "side": "right",
              "emotion": "smile",
              "voiceId": "VO_CK_06"
            }
          ],
          "clearDialog": [
            {
              "speaker": "旁白",
              "text": "盘面全部填满的那一刻，棋盘中央浮现出一行极淡的小字",
              "isNarration": true
            },
            {
              "speaker": "沈墨",
              "text": "（轻声念出）「当你看到这封信的时候，说明你已经找到了第一把钥匙。但真正的锁，在最后。」",
              "side": "left",
              "emotion": "thinking",
              "voiceId": "VO_SM_05"
            },
            {
              "speaker": "阿妍",
              "text": "（声音很轻）……最后一把锁。",
              "side": "right",
              "emotion": "calm",
              "voiceId": "VO_R_07"
            },
            {
              "speaker": "守笼人",
              "text": "七章档案，每一章都藏着一封密信。全部找到的人，才能看到……真正的结局。",
              "side": "right",
              "emotion": "serious",
              "voiceId": "VO_CK_02"
            }
          ]
        }
      ],
      "prologue": [
        {
          "type": "title",
          "text": "第一章",
          "subtitle": "初识笼中密码 · 楔子"
        },
        {
          "speaker": "沈墨",
          "text": "",
          "side": "left",
          "emotion": "confident",
          "bg": "assets/images/backgrounds/bg_scene1_single_door_v2.jpg"
        },
        {
          "speaker": "旁白",
          "text": "",
          "isNarration": true,
          "item": "file-k734"
        },
        {
          "speaker": "旁白",
          "text": "一封匿名信带你来到这里——信上只有一行字：\"档案编号K-734。如果你能解开这一局，就能找到我。\"",
          "isNarration": true,
          "sfx": "playDoorOpen"
        },
        {
          "speaker": "沈墨",
          "text": "……我来了。",
          "side": "left",
          "emotion": "confident",
          "voiceId": "VO_SM_01"
        },
        {
          "speaker": "旁白",
          "text": "守笼人从阴影中走出，脚步声在空旷的大厅中回响",
          "isNarration": true,
          "bg": "assets/images/backgrounds/bg_scene2_archive_hall.jpg",
          "sfx": "playFootstep"
        },
        {
          "speaker": "守笼人",
          "text": "欢迎来到数字档案馆。我是守笼人。这里记录着所有被锁住的数字，也记录着被锁住的过去。",
          "side": "right",
          "emotion": "default",
          "voiceId": "VO_CK_01"
        },
        {
          "speaker": "旁白",
          "text": "莹莹从书架后探出头，手里抱着一本比她脸还大的旧册子",
          "isNarration": true,
          "sfx": "playFootstep"
        },
        {
          "speaker": "莹莹",
          "text": "哇！来新人啦！我叫莹莹，比你早到两个月！",
          "side": "right",
          "emotion": "energetic",
          "voiceId": "VO_J_01"
        },
        {
          "speaker": "莹莹",
          "text": "这地方特——别——大——我第一天来的时候为了找厕所，在里面迷路了三天三夜！",
          "side": "right"
        },
        {
          "speaker": "旁白",
          "text": "阿妍从书架另一侧走出，手里拿着一支笔，没抬头",
          "isNarration": true
        },
        {
          "speaker": "阿妍",
          "text": "阿妍。比你早来三周。",
          "side": "right",
          "emotion": "calm",
          "voiceId": "VO_R_001"
        },
        {
          "speaker": "旁白",
          "text": "阿妍合上笔记，终于看向沈墨",
          "isNarration": true
        },
        {
          "speaker": "阿妍",
          "text": "这封信的内容，我已经确认过了——是真的。这间档案馆确实藏着什么。",
          "side": "right",
          "emotion": "calm",
          "voiceId": "VO_R_006"
        },
        {
          "speaker": "守笼人",
          "text": "无论你们各自抱着什么目的而来，在这间档案馆里，规则是第一位的。",
          "side": "right",
          "emotion": "serious",
          "voiceId": "VO_CK_02"
        },
        {
          "speaker": "守笼人",
          "text": "从今天起，你们将从最基础的4×4盘面学起。每行、每列、每个2×2小宫格里，数字只能出现一次。",
          "side": "right",
          "emotion": "serious",
          "voiceId": "VO_CK_03"
        },
        {
          "speaker": "旁白",
          "text": "莹莹举手",
          "isNarration": true
        },
        {
          "speaker": "莹莹",
          "text": "报告！我已经能背了！第一项：每行数字不重复！第二项：每列数字不重复！第三项：2×2宫格数字不重复！",
          "side": "right",
          "emotion": "confident",
          "voiceId": "VO_J_04"
        },
        {
          "speaker": "旁白",
          "text": "守笼人看了她一眼",
          "isNarration": true
        },
        {
          "speaker": "守笼人",
          "text": "……准备好了吗？",
          "side": "right",
          "emotion": "default",
          "voiceId": "VO_CK_04"
        }
      ],
      "epilogue": [
        {
          "speaker": "守笼人",
          "text": "记住一个秘密：4×4盘面每行每列每宫总和永远是10。6×6是21，9×9是45——我们管这叫“星衡”法则。",
          "side": "right",
          "voiceId": "VO_CK_05",
          "emotion": "default",
          "effect": 1
        },
        {
          "speaker": "莹莹",
          "text": "星衡法则？听起来好厉害！",
          "side": "right",
          "voiceId": "VO_J_03",
          "emotion": "surprised",
          "effect": 0
        },
        {
          "speaker": "旁白",
          "text": "阿妍经过你们身边，走向下一层的楼梯，没有回头",
          "isNarration": true
        },
        {
          "speaker": "阿妍",
          "text": "走了。",
          "side": "right",
          "voiceId": "VO_R_005",
          "emotion": "default",
          "effect": 0
        },
        {
          "speaker": "旁白",
          "text": "莹莹追上去",
          "isNarration": true
        },
        {
          "speaker": "莹莹",
          "text": "阿妍姐——等等我！",
          "side": "right",
          "voiceId": "VO_J_11",
          "emotion": "default",
          "effect": 0
        },
        {
          "speaker": "旁白",
          "text": "沈墨落在最后。楼梯拐角的光很暗，他没有立刻跟上。他站在楼梯口，最后看了一眼身后的档案室，然后转身，跟上了她们。他轻声说——像是给空气听的，也像是给自己听的",
          "isNarration": true
        },
        {
          "speaker": "沈墨",
          "text": "……“档案编号K-734。如果你能解开这一局，就能找到我。”……我不是来解开这一局的。我是来找到你的。",
          "side": "left",
          "sfx": "playFootstep",
          "voiceId": "VO_SM_11",
          "emotion": "default",
          "effect": 1
        }
      ]
    },
    {
      "chapterId": 2,
      "title": "四十五星衡",
      "subtitle": "基础篇 · 6×6/9×9",
      "icon": "⭐",
      "color": "#3b82f6",
      "description": "进入手稿室，学习星衡法则（星衡法则与星衡法则），掌握基础差值推演，初闻设局人留声印记。",
      "badgeId": "badge_c2_45rule",
      "badgeName": "星衡学徒",
      "unlockRequirement": 1,
      "badge": {
        "id": "badge_c2_45rule",
        "name": "星衡学徒",
        "icon": "⚖️",
        "description": "完成第二章「四十五星衡」，掌握星衡法则。"
      },
      "introStory": [
        {
          "type": "title",
          "text": "第二章",
          "subtitle": "四十五星衡"
        },
        {
          "speaker": "守笼人",
          "text": "这里是手稿室。从本章开始，你将接触六阶与九阶盘面。"
        },
        {
          "speaker": "阿妍",
          "text": "六阶每行和是二十一，九阶直接变四十五——记牢这两个基数，后面算笼子全靠它！"
        },
        {
          "speaker": "阿妍",
          "text": "对了，上一章你说的那个设计笼局的人，到底是谁？"
        },
        {
          "speaker": "守笼人",
          "text": "他曾与我一同研习笼局推演。我们称他为「设局人」。"
        },
        {
          "speaker": "守笼人",
          "text": "他另辟歧路，留下满室谜题便消失了多年。小心——他的留声印记可能出现在任何笼局中。"
        }
      ],
      "endingStory": [
        {
          "speaker": "守笼人",
          "text": "你已吃透星衡全部基础，设局人留下的深层档案即将解锁。"
        },
        {
          "speaker": "设局人",
          "text": "能闯过星衡试炼，勉强有资格直面我真正的笼局。"
        },
        {
          "speaker": "阿妍",
          "text": "我一定要解开所有谜题，搞懂你和守笼人当年到底发生了什么！"
        },
        {
          "speaker": "守笼人",
          "text": "第三章的笼局，藏着设局人与我决裂的全部真相。"
        }
      ],
