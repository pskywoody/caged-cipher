      "emotion": "confident",
      "voiceId": "VO_SM_05"
    },
    {
      "speaker": "莹莹",
      "text": "（擦干眼泪，用力点头）嗯！我爸留下的谜题——我要全部解开！",
      "side": "right",
      "emotion": "confident",
      "voiceId": "VO_J_05"
