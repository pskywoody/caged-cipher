# ============================================================
#  Caged Cipher · Git Ignore
#  只保留源代码和游戏资源，排除所有依赖和临时文件
# ============================================================

# --- 虚拟环境 & 依赖 ---
node_modules/
.venv*/
venv/
env/

# --- AI 模型文件 ---
models/
*.ckpt
*.pth
*.onnx
*.safetensors
*.pt

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- MimoCode / Trae internal ---
.mimocode/
.trae/

# --- Uploads & temp files ---
.uploads/
uploads/
tmp/
temp/

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- Output / build ---
output/
build/
dist/

# --- Cache ---
.cache/
.parcel-cache/
.next/

# --- Environment ---
.env
.env.local
.env.*.local

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# --- Audio temp ---
*.wav.bak
*.mp3.tmp

# --- 备份文件 ---
*.bak
*.backup
